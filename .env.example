# ============================================
# GitHub OAuth 配置
# ============================================
# 复制此文件为 .env 并填入实际值

# --- 本地开发 ---
# VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id
# VITE_OAUTH_PROXY_URL=http://localhost:8787

# --- 生产环境 ---
VITE_GITHUB_CLIENT_ID=Ov23liKw6PpaJIp5B0rR
VITE_OAUTH_PROXY_URL=https://cms.131714.xyz/auth

# ============================================
# 说明
# ============================================
# VITE_GITHUB_CLIENT_ID  : GitHub OAuth App 的 Client ID（公开，可放前端）
# VITE_OAUTH_PROXY_URL   : Cloudflare Worker 的 OAuth 代理地址
#                          本地: http://localhost:8787
#                          生产: https://cms.131714.xyz/auth
#
# Worker Secrets（通过 npx wrangler secret put 设置，不能放 .env）：
#   GITHUB_CLIENT_ID     同上
#   GITHUB_CLIENT_SECRET GitHub OAuth App 的 Client Secret（私密！）
#   REDIRECT_URI         必须与 GitHub OAuth App 设置的回调地址一致
#                        生产: https://cms.131714.xyz/auth/callback
#   CMS_ORIGIN           CMS 前端部署地址，如 https://cms-xxx.vercel.app